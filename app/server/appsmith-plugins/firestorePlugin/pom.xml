<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.appsmith</groupId>
        <artifactId>appsmith-plugins</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <groupId>com.external.plugins</groupId>
    <artifactId>firestorePlugin</artifactId>
    <version>1.0-SNAPSHOT</version>

    <name>firestorePlugin</name>

    <!-- These overrides apply only to this plugin. PF4J loads each plugin's own copies of these libraries,
         so they do not change the versions in server.jar or in other plugins. -->
    <properties>
        <!-- httpclient5 5.6.4 is the version firebase-admin declares. It depends on httpcore5 5.4.3, the version
             the root pom pins. The Spring Boot BOM version has CVE-2026-64607.
             Remove when the root pom or the Spring Boot BOM manages httpclient5 5.6.4 or later. -->
        <httpclient5.version>5.6.4</httpclient5.version>
        <!-- google-cloud-firestore declares OpenTelemetry 1.62.0, which has CVE-2026-118259, fixed in 1.67.0.
             Remove when google-cloud-firestore declares and the Spring Boot BOM manages 1.67.0 or later. -->
        <opentelemetry.version>1.67.0</opentelemetry.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>9.12.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-core</artifactId>
                </exclusion>
                <!-- The plugin does not use Cloud Storage. -->
                <exclusion>
                    <groupId>com.google.cloud</groupId>
                    <artifactId>google-cloud-storage</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <!-- FirestoreClientCache uses Guava. firebase-admin brings 33.6.0-jre, which has CVE-2026-102554. -->
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.7.2-jre</version>
        </dependency>

        <dependency>
            <!-- The OpenTelemetry API looks up this library's classes by name. Without it here, the plugin class loader
                 asks the server. The CE server has a copy, which comes from another class loader, so no Firestore client
                 can be created. Keep the default scope, so that it is in the plugin jar. -->
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api-incubator</artifactId>
            <version>${opentelemetry.version}-alpha</version>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>gcloud</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.testcontainers</groupId>
                    <artifactId>testcontainers</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
